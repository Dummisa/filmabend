rules_version = '2';

// Filmabend – Firestore-Regeln
// In der Firebase-Konsole unter Firestore Database → Regeln einfügen und veröffentlichen.
// Wie beim Essensplan: Jedes Gerät meldet sich anonym an, Profile laufen über den Namen.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function str(v, maxLen) { return v is string && v.size() <= maxLen; }
    function data() { return request.resource.data; }

    // Profile: alle angemeldeten Geräte dürfen lesen (Anmeldung per Name)
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && data().keys().hasOnly(['name', 'nameLower', 'createdAt'])
        && str(data().name, 30) && data().name.size() > 0
        && data().nameLower == data().name.lower();
      allow delete: if false;
    }

    // Persönliche Watchlist + gesehene Filme (ein Dokument pro Person)
    match /lists/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && exists(/databases/$(database)/documents/users/$(userId))
        && data().keys().hasOnly(['watch', 'seen', 'share', 'shareInit', 'inbox', 'rewatch', 'updatedAt'])
        && data().watch is map && data().watch.size() <= 3000
        && data().seen is map && data().seen.size() <= 5000
        && (!('share' in data()) || (data().share is map && data().share.size() <= 50))
        && (!('shareInit' in data()) || data().shareInit is map)
        && (!('inbox' in data()) || (data().inbox is map && data().inbox.size() <= 300))
        && (!('rewatch' in data()) || data().rewatch is map);
      allow delete: if false;
    }

    // Film- und Seriendaten von TMDB (gemeinsamer Zwischenspeicher; Serien: "tv<ID>")
    match /movies/{movieId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && movieId.matches('^(tv)?[0-9]{1,10}$')
        && data().keys().size() <= 30
        && str(data().title, 300)
        && (!('overview' in data()) || str(data().overview, 5000));
      allow delete: if false;
    }

    // Gruppen (geteilte Listen)
    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && data().keys().hasOnly(['name', 'code', 'members', 'type', 'createdBy', 'createdAt'])
        && (!('type' in data()) || data().type in ['movie', 'tv', 'mixed'])
        && str(data().name, 40) && data().name.size() > 0
        && data().code is string && data().code.matches('^[A-Z0-9]{6}$')
        && data().members is list && data().members.size() <= 30;
      allow update: if signedIn()
        && data().keys().hasOnly(['name', 'code', 'members', 'type', 'createdBy', 'createdAt'])
        && (!('type' in data()) || data().type in ['movie', 'tv', 'mixed'])
        && data().code == resource.data.code
        && str(data().name, 40) && data().name.size() > 0
        && data().members is list && data().members.size() <= 30;
      allow delete: if false;

      // Abstimmungen einer Gruppe (maxNominations 0 = unbegrenzt)
      match /votes/{voteId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && data().keys().hasOnly(['title', 'createdBy', 'createdAt', 'status', 'method', 'maxNominations',
                                    'conditions', 'nominations', 'ballots', 'result', 'closedAt'])
          && str(data().title, 60)
          && data().status in ['nominate', 'vote', 'closed']
          && data().method in ['approval', 'single', 'ranked']
          && data().maxNominations is int && data().maxNominations >= 0 && data().maxNominations <= 100
          && data().nominations is map && data().nominations.size() <= 100
          && data().ballots is map && data().ballots.size() <= 30;
        allow delete: if signedIn();
      }

      // Zusammen gesehene Filme einer Gruppe (Verlauf)
      match /watched/{movieId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && movieId.matches('^(tv)?[0-9]{1,10}$')
          && data().keys().hasOnly(['key', 'at', 'by'])
          && str(data().key, 20) && data().at is int && str(data().by, 40);
        allow delete: if signedIn();
      }
    }
  }
}
